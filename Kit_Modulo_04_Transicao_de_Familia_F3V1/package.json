{
  "name": "@atelie/kit-transicao-f3",
  "version": "0.1.0-candidate.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "doctor": "node tools/atelier.mjs doctor",
    "dev": "vite --config vite.config.ts",
    "build": "pnpm run compile:schemas && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
