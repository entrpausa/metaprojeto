    "serve:preview": "node tools/serve-preview.mjs",
    "release:check": "node tools/atelier.mjs release-check",
    "compile:schemas": "node tools/compile-validators.mjs"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "ajv": "8.20.0",
    "@types/node": "24.19.2"
  },
